# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Leave empty for same-origin web hosting. Set to the HTTPS API origin when building native apps.
VITE_API_BASE_URL=""
CORS_ORIGINS=""
WINDOWS_DOWNLOAD_URL=""
ANDROID_DOWNLOAD_URL=""
DATA_DIR="./data"
# Comma-separated extra browser origins when the web frontend is hosted separately.

# Required when the server runs in production. Replace with unique values and keep them server-side.
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret-value"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-unique-password-of-12-characters-or-more"
ADMIN_PIN="replace-with-a-unique-pin-of-12-characters-or-more"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
